<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo reference="body_link">
        <mu1>0.2</mu1>
        <mu2>0.75</mu2>
        <material>Gazebo/Red</material>
    </gazebo>

    <gazebo reference="extra_weight_link">
        <mu1>0.2</mu1>
        <mu2>0.75</mu2>
        <material>Gazebo/Green</material>
    </gazebo>

    <gazebo reference="wheel1_link">
        <mu1>0.2</mu1>
        <mu2>0.75</mu2>
        <material>Gazebo/Yellow</material>
    </gazebo>

    <gazebo reference="wheel2_link">
        <mu1>0.2</mu1>
        <mu2>0.75</mu2>
        <material>Gazebo/Yellow</material>
    </gazebo>

    <gazebo reference="caster_link">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <material>Gazebo/Green</material>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>${wheel_separation}</wheel_separation>
            <wheel_radius>${wheel_link_radius}</wheel_radius>
            <odom_publish_frequency>50</odom_publish_frequency>
            <topic>/model/micromouse_robot/cmd_vel</topic>
        </plugin>
    </gazebo>

    <gazebo reference="body_link">

        <sensor name="imu_sensor" type="imu">
            <pose relative_to='body_link'>${imu_x_location} ${imu_y_location} ${imu_z_location} 0 0 0</pose>
            <always_on>1</always_on>
            <update_rate>1</update_rate>
            <visualize>true</visualize>
            <topic>imu</topic>
        </sensor>

        <sensor name='sensor_ultrasonic_center' type='ray'>
            <pose relative_to='body_link'>${sensor_lidar_x_location} 0 ${sensor_lidar_z_location} 0 0 0</pose>
            <topic>ultrasonic_center</topic>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.02</min>
                    <max>4.0</max>
                </range>
            </ray>
            <always_on>1</always_on>
            <visualize>true</visualize>
        </sensor>

        <sensor name='sensor_ultrasonic_left' type='ray'>
            <pose relative_to='body_link'>${sensor_lidar_x_location} ${body_link_y_dim/2}
                ${sensor_lidar_z_location} 0 0 ${pi/4}</pose>
            <topic>ultrasonic_left</topic>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.02</min>
                    <max>4.0</max>
                </range>
            </ray>
            <always_on>1</always_on>
            <visualize>true</visualize>
        </sensor>

        <sensor name='sensor_ultrasonic_right' type='ray'>
            <pose relative_to='body_link'>${sensor_lidar_x_location} ${-body_link_y_dim/2}
                ${sensor_lidar_z_location} 0 0 ${-pi/4}</pose>
            <topic>ultrasonic_right</topic>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.02</min>
                    <max>4.0</max>
                </range>
            </ray>
            <always_on>1</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

</robot>
