<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="micromouse_robot">

  <xacro:include filename="body.xacro" />
  <xacro:include filename="wheel.xacro" />
  <xacro:include filename="caster.xacro" />

  <material name="Red">
    <color rgba="1 0 0 1"/>
  </material>

  <material name="Yellow">
    <color rgba="1 1 0 1"/>
  </material>

  <material name="Green">
    <color rgba="0 1 0 1"/>
  </material>


  <xacro:property name="pi" value="3.1415926535897931" />

  <xacro:property name="body_density" value="2710" />
  <xacro:property name="body_link_x_dim" value="0.1" />
  <xacro:property name="body_link_y_dim" value="0.08" />
  <xacro:property name="body_link_z_dim" value="0.03" />

  <xacro:property name="wheel_density" value="1200" />
  <xacro:property name="wheel_link_radius" value="0.02" />
  <xacro:property name="wheel_link_length" value="0.01" />
  <xacro:property name="wheel_separation" value="${body_link_y_dim + 0.01}" />

  <xacro:property name="caster_density" value="7870" />
  <xacro:property name="caster_link_radius" value="0.005" />

  <xacro:property name="imu_x_location" value="0" />
  <xacro:property name="imu_y_location" value="0" />
  <xacro:property name="imu_z_location" value="${body_link_z_dim / 2}" />
  <xacro:property name="sensor_lidar_x_location" value="${body_link_x_dim / 2}" />
  <xacro:property name="sensor_lidar_z_location" value="${body_link_z_dim / 2}" />


  <xacro:body
    name="body_link"
    rpy="0 0 0" xyz="0 0 0.036"
    x="${body_link_x_dim}" y="${body_link_y_dim}" z="${body_link_z_dim}"
    density="${body_density}" />

  <xacro:wheel
    name="wheel1_link"
    rpy="${pi/2} 0 0" xyz="0 0 0"
    radius="${wheel_link_radius}" length="${wheel_link_length}"
    density="${wheel_density}" />

  <xacro:wheel
    name="wheel2_link"
    rpy="${pi/2} 0 0" xyz="0 0 0"
    radius="${wheel_link_radius}" length="${wheel_link_length}"
    density="${wheel_density}" />

  <xacro:caster
    name="caster_link"
    rpy="0 0 0" xyz="0 0 0"
    radius="${caster_link_radius}"
    density="${caster_density}" />

  <link name="extra_weight_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.1" l="0.02" w="0.02" h="0.02" />
  </link>


  <joint name="left_wheel_joint" type="continuous">
    <parent link="body_link"/>
    <child link="wheel1_link"/>
    <origin xyz="0 ${wheel_separation / 2} ${-body_link_z_dim / 2 + 0.036}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="body_link"/>
    <child link="wheel2_link"/>
    <origin xyz="0 ${-wheel_separation / 2} ${-body_link_z_dim / 2 + 0.036}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="caster_joint" type="fixed">
    <parent link="body_link"/>
    <child link="caster_link"/>
    <origin xyz="${-body_link_x_dim / 2} 0 -0.03" rpy="0 0 0"/>
  </joint>

  <joint name="extra_weight_joint" type="fixed">
    <parent link="body_link"/>
    <child link="extra_weight_link"/>
    <origin xyz="0.03 0 ${body_link_z_dim/2}" rpy="0 0 0"/>
  </joint>


  <xacro:include filename="micromouse_robot.gazebo.xacro" />

</robot>
